[Unit]
Description=Free Welfare
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freewelfare
Group=freewelfare
WorkingDirectory=/opt/free-welfare
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/free-welfare/deploy/native/launcher.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
