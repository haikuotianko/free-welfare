# ============================================================
# Free Welfare 环境变量示例
# 复制为 .env 后填入真实值；不要提交 .env
# ============================================================

# 运行环境
NODE_ENV=production
TZ=Asia/Shanghai
LOG_LEVEL=info

# 应用
# 直接访问 API 时用 http://localhost:31888；用 Caddy/域名时改成 http(s)://域名
APP_URL=http://localhost:31888
# API 在容器内监听的端口（一般不用改）
APP_PORT=3000
# API 映射到宿主机的端口（NAS 上 31888 被占用时改这里）
API_HOST_PORT=31888
# 32 字节 base64；生成：openssl rand -base64 32
APP_ENCRYPTION_KEY=
# 会话签名密钥；生成：openssl rand -base64 32
AUTH_SESSION_SECRET=

# 数据库
POSTGRES_USER=welfare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=welfare
DATABASE_URL=postgresql://welfare:change-me@postgres:5432/welfare?schema=public

# YYB-Go-Enhanced（使用者自己部署）
YYB_BASE_URL=http://yyb-go:8000
YYB_INTEGRATION_TOKEN=
YYB_PROTOCOL_TOKEN=
YYB_HEALTHCHECK_INTERVAL_SECONDS=60

# 脚本订阅源
SCRIPT_SOURCE_URL=https://raw.githubusercontent.com/haikuotianko/free-welfare-scripts/main/index.json
SCRIPT_SOURCE_TRUST=official
SCRIPT_SOURCE_AUTO_SYNC=true

# Docker 镜像（NAS/服务器可改成自己的 GHCR 地址；本地构建时保留默认值）
FW_IMAGE=ghcr.io/haikuotianko/free-welfare:latest

# Caddy 对外端口（NAS 上 80/443 被占用时改成 8080/8443）
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Worker / Runner
WORKER_CONCURRENCY=2
RUNNER_TIMEOUT_SECONDS=120
RUNNER_MEMORY_MB=256
RUNNER_MAX_LOG_BYTES=262144

# 通知（也可在 Web 设置里填，设置里的值优先）
SERVERCHAN_TOKEN=

# 反向代理（Caddy）
CADDY_DOMAIN=localhost
CADDY_EMAIL=

# 数据目录（Docker 内路径）
DATA_DIR=/data
